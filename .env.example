# Copy this file to .env and fill in your local values.
# .env is ignored by git.

# Relay
ASKKING_PORT=8787
ASKKING_DB=./askking.sqlite
ASKKING_ADMIN_TOKEN=change-me
# Optional. If empty/unset, the Relay uses the first non-loopback LAN IPv4.
# ASKKING_PUBLIC_BASE_URL=http://192.168.1.23:8787
# Bonjour discovery is enabled by default for the iOS "automatic discovery" button.
ASKKING_BONJOUR_ENABLED=1
ASKKING_BONJOUR_NAME=AskKing Relay
ASKKING_CLIENT_NAME=Local Codex

# APNs
# Use 1 only after Apple Developer Push Notifications are enabled for the app id.
ASKKING_APNS_ENABLED=0
ASKKING_APNS_KEY_ID=ABC123DEFG
ASKKING_APNS_TEAM_ID=HYB659G8FH
ASKKING_APNS_TOPIC=app.askking.relay
ASKKING_APNS_KEY_PATH=/Users/yorick/Downloads/AuthKey_ABC123DEFG.p8

# Keep this unset/0 for Xcode development builds.
# Use 1 only for production APNs builds, such as TestFlight/App Store.
ASKKING_APNS_PRODUCTION=0

# AWS Lambda production alternative to ASKKING_APNS_KEY_PATH.
# ASKKING_APNS_KEY_SECRET_ID=arn:aws:secretsmanager:region:account:secret:askking/apns
