{
  "name": "askking",
  "private": false,
  "version": "0.1.0",
  "bin": {
    "askking": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/broker-*.js",
    "!dist/bonjour.js",
    "!dist/index.js",
    "!dist/pairing-qr.js",
    "!dist/store.js",
    "plugins",
    ".agents",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc",
    "prepack": "pnpm build",
    "dev": "tsx relay/src/cli.ts dev",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit",
    "cf:deploy": "wrangler deploy",
    "relay:pair": "tsx relay/src/cli.ts pair",
    "relay:client": "tsx relay/src/cli.ts client",
    "relay:mode": "tsx relay/src/cli.ts mode"
  },
  "dependencies": {
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@homebridge/ciao": "^1.3.9",
    "@hono/node-server": "^1.14.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.24",
    "better-sqlite3": "^11.10.0",
    "esbuild": "^0.28.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.64.0"
  }
}
